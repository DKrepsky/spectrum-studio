{
  "name": "spectrum-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop spectrum analyzer for SDRs, spectrum analyzers, recordings and a built-in simulator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bindings": "cargo test -p spectrum-core --features bindings --lib export_bindings && prettier --write src/bindings",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:web": "prettier --write src/bindings && npm run format:check && npm run lint && npm run typecheck && npm test",
    "check": "npm run check:rust && npm run check:web",
    "e2e": "tauri build --debug --no-bundle && wdio run e2e/wdio.conf.ts",
    "e2e:run": "wdio run e2e/wdio.conf.ts",
    "docs:screenshot": "wdio run e2e/screenshot.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
